# Copie para .env (gitignored). Crie a API key com:
#   mgc auth api-key create --name blocky-terraform --expiration AAAA-MM-DD \
#     --scopes '["virtual-machine.read","virtual-machine.write","network.read","network.write","object-storage.read","object-storage.write","gdb:ssh-pkey-r","gdb:azs-r","openid","profile"]'
#   mgc auth api-key get <uuid>   # mostra api_key, key_pair_id e key_pair_secret
export MGC_API_KEY=""
export TF_VAR_mgc_api_key=""
# Key pair da mesma API key (Object Storage / backend S3 do Terraform)
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
